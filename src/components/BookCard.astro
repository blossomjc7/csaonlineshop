---
import type { Book } from '../data/books';

interface Props {
  book: Book;
}

const { book } = Astro.props;
---

<div class="bg-white rounded-xl border border-gray-200 overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col group hover:-translate-y-1">
  <!-- Card Header Badge & Category -->
  <div class="p-6 pb-4 flex flex-col flex-grow">
    <div class="flex items-center justify-between gap-2 mb-3">
      <span class="text-[11px] font-montserrat uppercase tracking-wider font-semibold text-[#0A1128] bg-gray-100 px-2.5 py-1 rounded">
        {book.categoryLabel}
      </span>
      {book.badge && (
        <span class="text-[11px] font-montserrat uppercase tracking-wider font-bold text-[#0A1128] bg-[#D4AF37] px-2.5 py-1 rounded shadow-sm">
          {book.badge}
        </span>
      )}
    </div>

    <!-- Title & Subtitle -->
    <h3 class="font-playfair font-bold text-xl text-[#0A1128] group-hover:text-[#D4AF37] transition-colors line-clamp-2 mb-2 leading-snug">
      {book.title}
    </h3>
    <p class="text-xs font-medium text-gray-500 mb-3 line-clamp-1 italic">
      {book.subtitle}
    </p>

    <!-- Description -->
    <p class="text-sm text-gray-600 line-clamp-3 mb-4 leading-relaxed flex-grow">
      {book.description}
    </p>

    <!-- Features Pill List -->
    {book.features && (
      <ul class="space-y-1.5 mb-5 pt-3 border-t border-gray-100 text-xs text-gray-600">
        {book.features.slice(0, 2).map((feat) => (
          <li class="flex items-start gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#D4AF37] mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg>
            <span class="line-clamp-1">{feat}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <!-- Card Action Footer -->
  <div class="px-6 py-4 bg-gray-50/80 border-t border-gray-100 flex items-center justify-between gap-3">
    <div>
      <div class="text-[10px] font-montserrat uppercase tracking-wider text-gray-500 font-medium">Digital Edition</div>
      <div class="text-lg font-playfair font-bold text-[#0A1128]">{book.price}</div>
    </div>
    
    <div class="flex items-center gap-2">
      {book.externalReaderUrl && (
        <a 
          href={book.externalReaderUrl}
          target="_blank" 
          rel="noopener noreferrer"
          title="Open interactive multi-language reader"
          class="p-2.5 rounded-lg border border-gray-300 text-gray-700 hover:text-[#0A1128] hover:border-[#D4AF37] transition"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
        </a>
      )}
      <a 
        href={book.gumroadUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="px-4 py-2.5 rounded-lg bg-[#0A1128] text-white hover:bg-[#D4AF37] hover:text-[#0A1128] text-xs font-montserrat font-bold tracking-wider uppercase transition-all duration-300 shadow-sm"
      >
        Instant Buy
      </a>
    </div>
  </div>
</div>
