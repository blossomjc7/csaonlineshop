---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BookCard from '../components/BookCard.astro';
import { booksData } from '../data/books';

const categories = [
  { id: 'all', label: 'All Shelves' },
  { id: 'devotionals', label: 'Devotionals & Typology' },
  { id: 'culinary', label: 'Culinary Arts' },
  { id: 'poetry', label: 'Poetry & Musings' },
  { id: 'children', label: "Children's Stories" },
  { id: 'discernment', label: 'Spiritual Discernment' },
  { id: 'journals', label: 'Journals & Activity' },
];
---

<BaseLayout 
  title="Complete Book Catalog & Shelves | CSA Online Shop"
  description="Browse all published works by Christine A. Christian devotionals, culinary quick dinners, poetry collections, children's prophecy detectives, and study journals."
>
  <Header slot="header" />

  <!-- Page Header -->
  <section class="bg-[#0A1128] text-white py-16 border-b border-[#D4AF37]/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl">
      <span class="text-xs font-montserrat uppercase tracking-widest text-[#D4AF37] font-semibold mb-3 inline-block">
        Official Storefront & Library
      </span>
      <h1 class="font-playfair text-4xl sm:text-5xl font-bold mb-4">
        The Author's Bookshelf
      </h1>
      <p class="text-gray-300 text-base leading-relaxed">
        Explore every volume crafted by Christine A. Filter across Christian devotionals, culinary arts, contemplative poetry, children's adventures, and scripture study tools.
      </p>
    </div>
  </section>

  <!-- Interactive Filter Controls -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="flex flex-wrap items-center justify-center gap-2 mb-12">
      {categories.map((cat, idx) => (
        <button
          data-filter={cat.id}
          class={`filter-btn px-4 py-2 rounded-full font-montserrat text-xs uppercase tracking-wider font-semibold transition-all ${
            idx === 0 
              ? 'bg-[#0A1128] text-white shadow-md active-filter' 
              : 'bg-white text-gray-700 border border-gray-200 hover:border-[#D4AF37] hover:text-[#0A1128]'
          }`}
        >
          {cat.label}
        </button>
      ))}
    </div>

    <!-- Catalog Grid -->
    <div id="booksGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {booksData.map((book) => (
        <div data-category={book.category} class="book-item">
          <BookCard book={book} />
        </div>
      ))}
    </div>
  </section>

  <!-- External Reader Callout -->
  <section class="bg-white border-t border-gray-200 py-16">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-block p-3 rounded-full bg-[#D4AF37]/15 text-[#0A1128] mb-4">
        <svg class="w-8 h-8 text-[#D4AF37]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
      </div>
      <h2 class="font-playfair text-3xl font-bold text-[#0A1128] mb-3">Want To Read With Audio Narration?</h2>
      <p class="text-gray-600 max-w-2xl mx-auto mb-6 text-sm leading-relaxed">
        Visit our sister platform <strong class="text-[#0A1128]">spiritualbooks.csaonlineshop.com</strong> for multi-language text-to-speech audio, complete chapter readers, and study notes for the 75-book Divine Blueprint series.
      </p>
      <a 
        href="https://spiritualbooks.csaonlineshop.com" 
        target="_blank" 
        rel="noopener noreferrer"
        class="inline-block px-7 py-3 rounded-lg bg-[#0A1128] text-[#D4AF37] border border-[#D4AF37] font-montserrat text-xs uppercase tracking-wider font-bold hover:bg-[#D4AF37] hover:text-[#0A1128] transition-all"
      >
        Open Divine Blueprint Reader ➔
      </a>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll('.filter-btn');
  const items = document.querySelectorAll('.book-item');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      // Update button styles
      buttons.forEach((b) => {
        b.classList.remove('bg-[#0A1128]', 'text-white', 'shadow-md', 'active-filter');
        b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      });
      btn.classList.add('bg-[#0A1128]', 'text-white', 'shadow-md', 'active-filter');
      btn.classList.remove('bg-white', 'text-gray-700', 'border-gray-200');

      // Filter book items
      items.forEach((item) => {
        const cat = item.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
