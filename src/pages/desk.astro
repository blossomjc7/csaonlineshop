---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { articlesData } from '../data/books';
---

<BaseLayout 
  title="From the Author's Desk | Essays & Insights by Christine A."
  description="Read latest essays on biblical typology, prophetic perspectives, wholesome culinary reflections, and spiritual discernment."
>
  <Header slot="header" />

  <section class="bg-[#0A1128] text-white py-16 border-b border-[#D4AF37]/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-xs font-montserrat uppercase tracking-widest text-[#D4AF37] font-semibold mb-2 inline-block">
        Essays • Musings • Theological Study
      </span>
      <h1 class="font-playfair text-4xl sm:text-5xl font-bold mb-4">
        From the Author's Desk
      </h1>
      <p class="text-gray-300 text-base max-w-2xl mx-auto leading-relaxed">
        Unhurried thoughts on the Scriptures, the sacred ministry of the kitchen table, cultural currents, and walking in steady peace in 2026.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16 space-y-10">
    {articlesData.map((art) => (
      <article class="bg-white rounded-xl border border-gray-200 p-8 shadow-sm hover:shadow-md transition">
        <div class="flex items-center justify-between text-xs text-gray-500 mb-3 font-montserrat uppercase tracking-wider">
          <span class="text-[#D4AF37] font-bold">{art.category}</span>
          <span>{art.date} • {art.readTime}</span>
        </div>
        <h2 class="font-playfair font-bold text-2xl sm:text-3xl text-[#0A1128] mb-4 leading-snug">
          {art.title}
        </h2>
        <p class="text-gray-700 leading-relaxed mb-6 font-inter text-base">
          {art.excerpt}
        </p>
        <div class="pt-4 border-t border-gray-100 flex items-center justify-between">
          <span class="text-xs text-gray-500 font-medium">By {art.author}</span>
          <span class="font-montserrat font-bold text-xs uppercase tracking-wider text-[#0A1128] hover:text-[#D4AF37] cursor-pointer">
            Read Full Essay ➔
          </span>
        </div>
      </article>
    ))}
  </section>

  <Footer slot="footer" />
</BaseLayout>
