---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout 
  title="The CSA Community Hub | Fellowship & Study for Readers of Christine A."
  description="A quiet, Christ-centered sanctuary away from algorithmic noise. Connect with fellow readers, study the Scriptures, share recipes, and fellowship."
>
  <Header slot="header" />

  <section class="bg-[#0A1128] text-white py-20 border-b border-[#D4AF37]/30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#D4AF37]/20 border border-[#D4AF37]/40 text-[#D4AF37] font-montserrat text-xs uppercase tracking-widest font-semibold mb-4">
        The CSA Gathering
      </div>
      <h1 class="font-playfair text-4xl sm:text-5xl font-bold mb-4">
        A Peaceful Sanctuary for Real Believers
      </h1>
      <p class="text-gray-300 text-base max-w-2xl mx-auto leading-relaxed">
        Step beyond noisy algorithms and combative online spaces. We are building a high-trust, peaceful circle to discuss biblical truth, share life testimonies, and cultivate genuine fellowship.
      </p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <!-- Invitation Form Box -->
    <div class="bg-white rounded-2xl border border-gray-200 p-8 sm:p-12 shadow-md">
      <div class="max-w-xl mx-auto text-center mb-8">
        <h2 class="font-playfair text-2xl sm:text-3xl font-bold text-[#0A1128] mb-3">
          Request An Invitation to Our Reader Circle
        </h2>
        <p class="text-sm text-gray-600 leading-relaxed">
          To preserve peace, sound biblical discussion, and safety, membership in our reader community is private and invite-only. Enter your details below to receive our early invite link.
        </p>
      </div>

      <form class="max-w-lg mx-auto space-y-4" onsubmit="event.preventDefault(); alert('Thank you for requesting an invitation! Christine will review your request and send your private invite.');">
        <div>
          <label class="block text-xs font-montserrat uppercase tracking-wider text-gray-700 font-semibold mb-1.5">Your Full Name</label>
          <input type="text" required placeholder="e.g. Sarah Jenkins" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#0A1128] focus:ring-1 focus:ring-[#0A1128] text-sm" />
        </div>

        <div>
          <label class="block text-xs font-montserrat uppercase tracking-wider text-gray-700 font-semibold mb-1.5">Email Address</label>
          <input type="email" required placeholder="name@example.com" class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#0A1128] focus:ring-1 focus:ring-[#0A1128] text-sm" />
        </div>

        <div>
          <label class="block text-xs font-montserrat uppercase tracking-wider text-gray-700 font-semibold mb-1.5">What Book or Subject Brought You Here?</label>
          <select class="w-full px-4 py-3 rounded-lg border border-gray-300 focus:outline-none focus:border-[#0A1128] text-sm text-gray-700">
            <option>The Divine Blueprint Series (Devotionals)</option>
            <option>20 Under 20 & Culinary Arts</option>
            <option>Whispers Across the Waters (Poetry)</option>
            <option>The Young Prophecy Detectives (Children)</option>
            <option>Biblical Dream Interpretation & Discernment</option>
            <option>General Fellowship & Seeking Truth</option>
          </select>
        </div>

        <button type="submit" class="w-full py-3.5 rounded-lg bg-[#0A1128] text-white hover:bg-[#D4AF37] hover:text-[#0A1128] font-montserrat font-bold text-xs uppercase tracking-wider transition-all duration-300 shadow-sm mt-4">
          Submit Invitation Request
        </button>

        <p class="text-[11px] text-gray-500 text-center pt-2">
          Your information is strictly private. Zero spam, zero third-party tracking.
        </p>
      </form>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
